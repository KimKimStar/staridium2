# ==========================================
# 둥글이 AI 방송국 Studio 환경설정 (.env.local)
# ==========================================

# 1. Supabase 설정 (대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # 백엔드 권한용 (RLS 우회)

# 2. Google Gemini API 설정 (Google AI Studio)
# 영수증/사진 2중 검증 및 3초 숏폼 후킹 카피 생성에 사용
GEMINI_API_KEY="AIzaSy..."

# 3. Replicate API 설정 (AI 모션 스왑 & AnimateAnyone 모델 구동용)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN="r8_..."

# 4. Stripe 결제 및 Webhook 설정 (Stripe Dashboard)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..." # 월 9,900원 recurring 가격 ID (선택사항, 미지정시 인라인 생성)

# 5. 앱 기본 URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 6. FFmpeg 경로 (시스템 전역에 ffmpeg가 없을 경우 지정)
# FFMPEG_PATH="C:/ffmpeg/bin/ffmpeg.exe"
